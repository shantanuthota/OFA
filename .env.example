# Local API / dashboard settings
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501
LOG_LEVEL=INFO

# Paths (relative paths resolve from project folder)
ONION_DATA_PATH=data/Onion_Model_Ready_Dataset_Chronos2.csv
ONION_DB_PATH=data/onion_history.sqlite3
CHRONOS_MODEL_ID=amazon/chronos-2

# Optional ingestion security key. Set this to a long random value before exposing
# any ingestion endpoint outside localhost. Graph endpoints do not use this key.
INGESTION_API_KEY=change-this-local-secret

# Official UPAg Open API connection. Do NOT commit real credentials to Git.
UPAG_BASE_URL=https://data.upag.gov.in
UPAG_USERNAME=
UPAG_PASSWORD=
UPAG_CLIENT_ID=
UPAG_CLIENT_SECRET=
UPAG_SCOPE=
